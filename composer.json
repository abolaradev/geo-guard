{
    "name": "abolaradev/geo-guard",
    "description": "GeoGuard is a Laravel package for IP geolocation, visitor profiling, and geographic access control. It provides location details, timezone, ISP, ASN, and proxy/hosting detection, with tools to restrict or allow access based on visitor locations.",
    "keywords": [
        "abolaradev",
        "laravel",
        "geo-guard"
    ],
    "homepage": "https://github.com/abolaradev/geo-guard",
    "license": "MIT",
    "authors": [
        {
            "name": "abolaradev",
            "email": "abolfazlebrahimi923395@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0.0||^10.0.0||^9.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Abolaradev\\GeoGuard\\": "src/",
            "Abolaradev\\GeoGuard\\Database\\Factories\\": "database/factories/"
        },
        "files": []
    },
    "autoload-dev": {
        "psr-4": {
            "Abolaradev\\GeoGuard\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare",
            "@composer run prepare"
        ],
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Abolaradev\\GeoGuard\\GeoGuardServiceProvider"
            ],
            "aliases": {
                "GeoGuard": "Abolaradev\\GeoGuard\\Facades\\GeoGuard"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}